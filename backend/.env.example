# Application
APP_NAME=Job Application Tracker
APP_ENV=development
API_VERSION=v1

API_ENV=development
API_BASE_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase Admin (never commit real values)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google OAuth / Gmail API — Phase 5
# Create OAuth client in Google Cloud Console (Web application)
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
#
# Local:
#   GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
# Production (Vercel):
#   GOOGLE_REDIRECT_URI=https://job-tracker-one-jade.vercel.app/api/v1/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback

# Deep link targets after OAuth (Flutter)
GMAIL_FRONTEND_SUCCESS_URL=jobtracker://gmail/connected
GMAIL_FRONTEND_ERROR_URL=jobtracker://gmail/error

# Encryption for Gmail tokens — Phase 5 (never commit real values)
# Either a Fernet key or any secret string (SHA-256 derived)
ENCRYPTION_KEY=
GMAIL_TOKEN_ENCRYPTION_KEY=

# Gmail sync rate limiting (seconds between syncs for one user).
# Each sync spends the user's own Gmail API quota. Set to 0 to disable.
GMAIL_SYNC_COOLDOWN_SECONDS=60
GMAIL_FULL_SYNC_COOLDOWN_SECONDS=300

# Optional logging
LOG_LEVEL=INFO
