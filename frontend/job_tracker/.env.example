# Copy to .env and fill in real values. Never commit .env.
# cp .env.example .env

# FastAPI base URL
# Android emulator → host machine: http://10.0.2.2:8000
# iOS simulator / desktop: http://127.0.0.1:8000
# Physical device: http://<your-lan-ip>:8000
API_BASE_URL=http://10.0.2.2:8000

# Firebase / Google Sign-In — Web client ID from Firebase Console
# (Authentication → Sign-in method → Google → Web client ID)
GOOGLE_SERVER_CLIENT_ID=

# Optional: Firebase project id (informational; options come from firebase_options.dart)
FIREBASE_PROJECT_ID=
